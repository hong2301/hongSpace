    {
      "compilerOptions": {
        /* 基础选项 */
        "target": "ES2020",                  // 编译到哪个 ECMAScript 版本
        "module": "CommonJS",               // 使用的模块系统，Node.js 默认是 CommonJS
        "lib": ["ES2020"],                  // 编译过程中需要引入的库文件

        /* 目录选项 */
        "rootDir": "./src",                 // 输入文件（.ts 文件）所在的根目录
        "outDir": "./dist",                 // 输出文件（编译后的 .js 文件）存放的目录

        /* 严格类型检查选项 (强烈推荐开启) */
        "strict": true,                     // 启用所有严格类型检查
        "noImplicitAny": true,              // 不允许隐式的 any 类型
        "strictNullChecks": true,           // 严格的 null 检查
        "strictFunctionTypes": true,        // 严格的函数类型检查

        /* 模块解析选项 */
        "baseUrl": ".",                     // 用于解析非相对模块名称的基目录
        "paths": {
          "@/*": ["src/*"]                  // 配置路径别名，方便 import
        },

        /* 额外选项 */
        "esModuleInterop": true,            // 允许通过 import 导入使用 CommonJS 导出的模块
        "skipLibCheck": true,               // 跳过对声明文件的类型检查
        "forceConsistentCasingInFileNames": true // 强制文件名大小写一致
      },
      "include": ["src/**/*"],             // 只编译 src 目录下的文件
      "exclude": ["node_modules", "**/*.spec.ts"] // 排除的文件
    }
    